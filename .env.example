# Truvio API — example settings. Copy to .env for local use (never commit real keys).

# Port (hosts like Render set PORT for you)
PORT=8787

# API keys, comma-separated. Make one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
TRUVIO_API_KEYS=

# true = anyone can call the API without a key (with the lower limits). false = a key is always required.
TRUVIO_PUBLIC_ACCESS=true

# Websites allowed to call the API from a browser
TRUVIO_CORS_ORIGINS=https://nexoradev-stack.github.io

# Limits (per minute)
TRUVIO_RATE_WINDOW_MS=60000
TRUVIO_PUBLIC_RATE_LIMIT=30
TRUVIO_PUBLIC_BATCH_MAX=50
TRUVIO_KEY_RATE_LIMIT=120
TRUVIO_KEY_BATCH_MAX=500

# DNS
TRUVIO_DNS_TIMEOUT_MS=5000
TRUVIO_DNS_TRIES=2
# Optional, e.g. 1.1.1.1,8.8.8.8 (empty = the server's own DNS)
TRUVIO_DNS_SERVERS=
TRUVIO_DNS_CACHE_TTL_MS=600000
