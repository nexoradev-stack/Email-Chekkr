# Email Chekkr API — example settings. Copy to .env for local use (never commit real keys).
# Settings use the EMAIL_CHEKKR_ prefix. The older TRUVIO_ names still work.

# Port (hosts like Render set PORT for you)
PORT=8787

# API keys, comma-separated. Make one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
EMAIL_CHEKKR_API_KEYS=

# true = anyone can call the API without a key (with the lower limits). false = a key is always required.
EMAIL_CHEKKR_PUBLIC_ACCESS=true

# Websites allowed to call the API from a browser
EMAIL_CHEKKR_CORS_ORIGINS=https://nexoradev-stack.github.io

# Limits (per minute)
EMAIL_CHEKKR_RATE_WINDOW_MS=60000
EMAIL_CHEKKR_PUBLIC_RATE_LIMIT=30
EMAIL_CHEKKR_PUBLIC_BATCH_MAX=50
EMAIL_CHEKKR_KEY_RATE_LIMIT=120
EMAIL_CHEKKR_KEY_BATCH_MAX=500

# DNS
EMAIL_CHEKKR_DNS_TIMEOUT_MS=5000
EMAIL_CHEKKR_DNS_TRIES=2
# Optional, e.g. 1.1.1.1,8.8.8.8 (empty = the server's own DNS)
EMAIL_CHEKKR_DNS_SERVERS=
EMAIL_CHEKKR_DNS_CACHE_TTL_MS=600000
